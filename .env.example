# MilestonePay Root Environment Configuration

# Stellar Network Settings
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"

# Canonical Testnet Native Token Contract ID (XLM SAC)
STELLAR_NATIVE_SAC_ID="CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC"

# Deployed Escrow Contract ID (Set after running contract deployment)
MILESTONE_ESCROW_CONTRACT_ID=""

# Backend Database & Indexer
DATABASE_URL="postgresql://milestonepay:milestonepay_dev_password@localhost:5432/milestonepay_db?schema=public"
PORT=4000
INDEXER_POLL_INTERVAL_MS=5000

# Web Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_STELLAR_NETWORK="testnet"
NEXT_PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
NEXT_PUBLIC_ESCROW_CONTRACT_ID=""
NEXT_PUBLIC_XLM_SAC_CONTRACT_ID="CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC"
